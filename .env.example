# Polymarket Public Endpoints (No private key required for 7-day Paper Trading!)
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# AI News Latency Evaluator (Optional during pure arb test)
GEMINI_API_KEY=your_gemini_api_key_here
NEWS_MAX_AGE_SEC=120

# Paper Trading Simulation Parameters
PAPER_STARTING_BANKROLL_USDC=1000.0
MAX_POSITION_USDC=50.0
MIN_ARB_NET_EDGE=0.015
ARB_TARGET_SHARES=25.0
# Trading costs. Both default to 0: set them before trusting any simulated profit.
# TAKER_FEE_BPS: taker fee in basis points of the amount spent (200 = 2%). Take it from
# Polymarket's fee schedule for the markets you track; many markets charge nothing.
TAKER_FEE_BPS=0
# SLIPPAGE_BUFFER: extra margin per 1 USDC of payoff required on arbitrage signals,
# for prices moving between the signal and the fill (e.g. 0.005).
SLIPPAGE_BUFFER=0.0
LOG_FILE_PATH=logs/paper_trades.jsonl
